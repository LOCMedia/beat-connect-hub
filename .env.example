# ============================================================
# Frontend (Vite) — public values, safe to ship to the browser
# ============================================================
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# ============================================================
# Edge Function secrets — set via `supabase secrets set KEY=value`
# These are NEVER exposed to the browser.
# ============================================================

# Supabase (auto-provided when deployed to Supabase; required only for local dev)
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Email — Resend (https://resend.com/api-keys)
# Used by: subscribe-newsletter, send-announcement, process-email-queue,
#          send-free-beat-download, send-transactional-email
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Optional: site URL used in email unsubscribe links
SITE_URL="https://vibekonect.com"

# Google Gemini — free tier (https://aistudio.google.com/app/apikey)
# Used by: generate-lyrics
GOOGLE_GEMINI_API_KEY="AIza..."

# Google OAuth (sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# YouTube integration
YOUTUBE_CHANNEL_ID=""